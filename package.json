{
  "name": "metaforge",
  "private": true,
  "version": "0.1.0",
  "description": "MetaForge 元数据驱动低代码平台 · 协议、出码工具与本地联调入口",
  "type": "module",
  "scripts": {
    "validate": "node tools/validate.mjs",
    "gen:ts": "node tools/gen-ts.mjs",
    "gen:java": "node tools/gen-java.mjs",
    "gen:entity": "node tools/gen-entity.mjs examples/leave-approval.bundle.json",
    "gen:api": "node tools/gen-api.mjs examples/leave-approval.bundle.json",
    "gen:page": "node tools/gen-page.mjs examples/leave-approval.bundle.json",
    "gen:project": "node tools/gen-project.mjs examples/leave-approval.bundle.json",
    "mock": "node tools/dev/mock-bff.mjs",
    "dev:studio": "npm --prefix platform run dev",
    "build:studio": "npm --prefix platform run build",
    "dev:web": "npm --prefix codegen/leave_approval/web run dev",
    "dev": "node tools/dev/dev.mjs"
  }
}
