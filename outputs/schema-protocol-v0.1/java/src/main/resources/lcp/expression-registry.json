  "queryOperators": [
    {
      "op": "eq",
      "label": "等于",
      "args": 1,
      "sql": "{col} = {p}",
      "widgetHint": "x-input"
    },
    {
      "op": "ne",
      "label": "不等于",
      "args": 1,
      "sql": "{col} <> {p}",
      "widgetHint": "x-input"
    },
    {
      "op": "like",
      "label": "包含",
      "args": 1,
      "sql": "{col} ILIKE {p}",
      "widgetHint": "x-input",
      "note": "值由编译器包 % 并由参数绑定，禁止字符串拼接"
    },
    {
      "op": "startsWith",
      "label": "开头是",
      "args": 1,
      "sql": "{col} ILIKE {p}",
      "widgetHint": "x-input"
    },
    {
      "op": "in",
      "label": "属于",
      "args": "n",
      "sql": "{col} = ANY({p})",
      "widgetHint": "x-select"
    },
    {
      "op": "between",
      "label": "区间",
      "args": 2,
      "sql": "{col} BETWEEN {p1} AND {p2}",
      "widgetHint": "x-date-picker",
      "note": "日期区间用 daterange，右端按字段类型补 23:59:59 或加一天"
    },
    {
      "op": "gt",
      "label": "大于",
      "args": 1,
      "sql": "{col} > {p}",
      "widgetHint": "x-number"
    },
    {
      "op": "gte",
      "label": "大于等于",
      "args": 1,
      "sql": "{col} >= {p}",
      "widgetHint": "x-number"
    },
    {
      "op": "lt",
      "label": "小于",
      "args": 1,
      "sql": "{col} < {p}",
      "widgetHint": "x-number"
    },
    {
      "op": "lte",
      "label": "小于等于",
      "args": 1,
      "sql": "{col} <= {p}",
      "widgetHint": "x-number"
    },
    {
