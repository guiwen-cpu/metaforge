{
  "$id": "https://lcp.dev/schema/0.1/expression-registry.json",
  "title": "LCP Expression Registry v0.1",
  "protocolVersion": "0.1",
  "description": "统一表达式 DSL 的唯一权威注册表。前端求值器、BFF 求值器、Flowable 变量绑定、规则引擎、数据权限下推、AI 生成校验器全部读这一份。新增函数=改这一个文件；任何一端私自定义函数视为缺陷。",
  "fieldDocs": {
    "name": "函数名，$fn 的取值",
    "cat": "分类，用于设计器分组与 AI 提示",
    "arity": "[最小参数个数, 最大参数个数]，null 表示不限",
    "params": "位置参数的类型提示，variadic 时按最后一个循环",
    "returns": "返回类型",
    "pure": "是否纯函数。false 者禁止出现在 Access.rowFilter / Index.where 等编译期下推位置",
    "desc": "中文说明，同时作为 AI 的语义提示"
  },
  "types": [
    "any",
    "string",
    "number",
    "integer",
    "boolean",
    "date",
    "array",
    "object",
    "file",
    "null"
  ],
  "operators": [
    "$lit",
    "$ref",
    "$fn",
    "$tpl",
    "$if"
  ],
  "valueRoots": [
    {
      "name": "$user",
      "type": "object",
      "nullable": false,
      "desc": "当前用户。fields 为约定字段，租户可扩展至 user.attrs.*",
      "fields": {
        "id": "string",
        "name": "string",
        "username": "string",
        "tenantId": "string",
        "deptId": "string",
        "deptIds": "array",
        "roleKeys": "array",
        "email": "string",
        "phone": "string",
        "attrs": "object"
      }
    },
    {
      "name": "$tenant",
      "type": "object",
      "nullable": false,
      "desc": "当前租户",
      "fields": {
        "id": "string",
        "code": "string",
        "name": "string",
        "attrs": "object"
      }
    },
    {
      "name": "$env",
      "type": "object",
      "nullable": false,
      "desc": "运行环境",
      "fields": {
        "platform": "string",
        "locale": "string",
        "timezone": "string",
        "appVersion": "string",
        "mode": "string"
      }
    },
    {
      "name": "$now",
      "type": "string",
      "nullable": false,
      "desc": "当前时间 ISO8601，每次求值稳定（同一动作链内冻结）"
    },
    {
      "name": "$page",
      "type": "object",
      "nullable": false,
      "desc": "当前页面上下文。state 暴露 UISchema.state 声明的状态变量（读用 $page.state.x；写用 AssignStep.target 的相对路径 state.x）",
      "fields": {
        "id": "string",
        "key": "string",
        "params": "object",
        "query": "object",
        "state": "object"
      }
    },
    {
      "name": "$route",
      "type": "object",
      "nullable": false,
      "desc": "当前路由",
      "fields": {
        "path": "string",
        "query": "object",
        "params": "object"
      }
    },
    {
      "name": "$form",
      "type": "object",
      "nullable": true,
      "desc": "当前表单模型（创建型/编辑型表单的字段值），键为字段 key"
    },
    {
      "name": "$row",
      "type": "object",
      "nullable": true,
      "desc": "当前行（表格行操作、详情页主体）"
    },
    {
      "name": "$rows",
      "type": "array",
      "nullable": true,
      "desc": "当前列表已加载数据"
    },
    {
      "name": "$data",
      "type": "object",
      "nullable": false,
      "desc": "按 dataSourceId 索引的数据源结果：$data.dsUsers.rows / .total / .page / .loading / .item"
    },
    {
      "name": "$process",
      "type": "object",
      "nullable": true,
      "desc": "审批流上下文，非流程页面为 null",
      "fields": {
        "processInstanceId": "string",
        "taskId": "string",
        "taskKey": "string",
        "taskName": "string",
        "initiator": "string",
        "status": "string",
        "variables": "object"
      }
    },
    {
      "name": "$ctx",
      "type": "object",
      "nullable": false,
      "desc": "动作执行上下文。result=紧邻上一步的结果（下一步即被覆盖，跨步骤请用 vars）；vars=动作链内的临时变量（assignTo 前缀 vars 写入）；params=动作入参；event=触发事件载荷",
      "fields": {
        "params": "object",
        "event": "object",
        "vars": "object",
        "result": "any",
        "error": "object",
        "actionKey": "string",
        "stepIndex": "integer"
      }
    },
    {
      "name": "$component",
      "type": "object",
      "nullable": true,
      "desc": "组件作用域内可用：$component.id / .key / .props"
    },
    {
      "name": "$res",
      "type": "object",
      "nullable": true,
      "desc": "HTTP 响应对象。仅在 Api.response 的解析表达式（successWhen / mapping / rowsPath / totalPath / errorPath / errorMessagePath）内可用：$res.status 为 HTTP 状态码，$res.body 为解析后的响应体，$res.headers 为响应头。步骤外读响应体请用 assignTo 落到 $ctx.vars.x。",
      "fields": {
        "status": "integer",
        "body": "any",
        "headers": "object"
      }
    }
  ],
