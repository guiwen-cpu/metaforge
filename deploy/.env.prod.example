# prod：复制为 deploy/.env.prod（已 gitignore，勿提交）
# TAG 必须是发布过的不可变版本（v1.2.3 或 sha-xxxxxxx），禁止 latest。
TAG=v0.1.0
WEB_PORT=8080
POSTGRES_PASSWORD=change-me-prod-owner
META_FORGE_APP_PASSWORD=change-me-prod-app
REDIS_PASSWORD=change-me-prod-redis
# 至少 32 字节的随机串；staging / prod 不要复用开发默认值
LCP_JWT_SECRET=change-me-prod-jwt-secret-at-least-32-bytes
# 租户密钥库主密钥：必填，`openssl rand -base64 32`；丢失将无法解密已有密钥。
LCP_SECRET_MASTER_KEY=
# 连接器出站默认只允许 HTTPS 与公网地址。
LCP_CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
LCP_CONNECTOR_ALLOW_INSECURE_HTTP=false

# 可选：统一身份登录。默认关闭；开启后补齐对应 OIDC / CAS 参数。
# OIDC:
# LCP_SSO_ENABLED=true
# LCP_SSO_MODE=oidc
# LCP_SSO_PROVIDER=school-oidc
# LCP_SSO_DISPLAY_NAME=学校统一身份
# LCP_SSO_TENANT=tenant_demo_school
# LCP_SSO_CLIENT_ID=metaforge
# LCP_SSO_CLIENT_SECRET=change-me
# LCP_SSO_AUTHORIZE_URL=https://idp.example.edu/oauth2/authorize
# LCP_SSO_TOKEN_URL=https://idp.example.edu/oauth2/token
# LCP_SSO_USERINFO_URL=https://idp.example.edu/oauth2/userinfo
# LCP_SSO_JWKS_URL=https://idp.example.edu/oauth2/jwks
# LCP_SSO_ISSUER=https://idp.example.edu
# LCP_SSO_REDIRECT_URI=https://example.edu/api/v1/auth/sso/callback
# LCP_SSO_FRONTEND_BASE_URL=https://example.edu
# LCP_SSO_LINK_BY=username
# LCP_SSO_AUTO_CREATE=false
# CAS: LCP_SSO_MODE=cas，并配置 LCP_SSO_CAS_SERVER_URL 与 LCP_SSO_CAS_VALIDATE_PATH。
# 生产环境务必使用 HTTPS；仅本地假 IdP 调试时设置 LCP_SSO_ALLOW_INSECURE_HTTP=true。
# 可选：微信小程序登录。AppSecret 只放服务端环境变量，绝不下发前端。
# LCP_WECHAT_ENABLED=true
# LCP_WECHAT_APP_ID=wx0000000000000000
# LCP_WECHAT_APP_SECRET=change-me
# LCP_WECHAT_TENANT=tenant_demo_school
# LCP_WECHAT_LINK_BY=username
# LCP_WECHAT_AUTO_CREATE=false
# 真机必须使用 HTTPS 的合法域名；仅本地假 jscode2session 服务才覆盖 API_BASE。
# LCP_WECHAT_API_BASE=https://api.weixin.qq.com
