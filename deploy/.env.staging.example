# staging：复制为 deploy/.env.staging（已 gitignore，勿提交）
# 与 prod 使用独立的 Compose 项目名与数据卷，可在同一台机器共存。
TAG=staging
WEB_PORT=8081
POSTGRES_PASSWORD=change-me-staging-owner
META_FORGE_APP_PASSWORD=change-me-staging-app
REDIS_PASSWORD=change-me-staging-redis
# 至少 32 字节的随机串；staging / prod 不要复用开发默认值
LCP_JWT_SECRET=change-me-staging-jwt-secret-at-least-32-bytes
