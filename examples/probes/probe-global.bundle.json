              "storage": {
                "primaryKey": "id", "idType": "ulid", "tenantColumn": null, "jsonbColumn": "ext",
                "softDelete": { "enabled": true },
                "timestamps": { "createdAt": "created_at", "updatedAt": "updated_at", "createdBy": "created_by", "updatedBy": "updated_by" }
